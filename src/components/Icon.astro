  dining: 'M6 3v8m-2-8v6a2 2 0 0 0 4 0V3M6 11v10M16 3c-2 0-3 2-3 5v3h3v10M16 3v18',
  security: 'M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z',
