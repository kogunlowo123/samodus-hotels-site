---
/**
 * Google Maps embed for the hotel's address, loaded lazily, with a direct
 * link to open the listing in Google Maps for directions.
 */
import { site, fullAddress } from '@/config/site';
const embed = `https://maps.google.com/maps?q=${site.geo.lat},${site.geo.lng}&z=16&output=embed`;
---

<div class="map">
  <iframe
    src={embed}
    title="Map showing Samodus Hotels, 15 Ademosu Street, Sabo, Sagamu"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <div class="map__bar">
    <p class="map__addr">{fullAddress()}</p>
    <a class="btn btn--secondary" href={site.mapsDirectionsUrl} target="_blank" rel="noopener">
      Open in Google Maps<span class="visually-hidden"> (opens in new tab)</span>
    </a>
  </div>
</div>

<style>
  .map {
    display: grid;
    gap: var(--s-3);
  }
  .map iframe {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    border-radius: var(--radius);
    background: var(--tint-2);
  }
  @media (min-width: 720px) {
    .map iframe {
      aspect-ratio: 16 / 10;
    }
  }
  .map__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .map__addr {
    font-family: var(--font-serif);
    font-size: var(--fs-1);
  }
</style>
