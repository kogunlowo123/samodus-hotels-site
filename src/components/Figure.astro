---
/**
 * Photography slot. Renders the hotel's own photo, a credited licensed stock
 * image with a visible "Representative image" caption, or a labelled
 * placeholder frame. Never passes stock off as the property.
 */
import { img, imageSrc, imageSrcset, imageLqip, type ImageSlot } from '@/data/images';
import { site } from '@/config/site';

interface Props {
  image: string | ImageSlot;
  caption?: boolean;
  priority?: boolean;
  sizes?: string;
  class?: string;
  ratio?: string;
  /** Hide the representative-image caption (e.g. inside the hero where the panel says it). */
  quiet?: boolean;
}

const {
  image: s,
  caption = false,
  priority = false,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  class: cls = '',
  ratio,
  quiet = false,
} = Astro.props;
const slot = typeof s === 'string' ? img(s) : s;
const src = imageSrc(slot);
const srcset = imageSrcset(slot);
const lqip = imageLqip(slot);
const ar = ratio ?? `${slot.width} / ${slot.height}`;
const isPlaceholder = slot.kind === 'placeholder';
void quiet; // overlay captions were removed; representative images are disclosed on the Gallery page and in alt text
---

<figure class:list={['ph', 'ph--frame', cls]} style={`--ar:${ar}${lqip ? `;background-image:url(${lqip});background-size:cover` : ''}`}>
  <img
    src={src}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    alt={slot.alt}
    width={slot.width}
    height={slot.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {isPlaceholder && site.previewMode && <span class="ph__tag" aria-hidden="true">Photo pending</span>}
  {caption && slot.caption && <figcaption class="ph__cap">{slot.caption}</figcaption>}
</figure>
