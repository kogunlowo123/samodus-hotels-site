---
import { site, hasPhone, hasWhatsApp, hasEmail, telHref, whatsappHref } from '@/config/site';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__addr">
        <p class="ftr__name">Samodus Hotels</p>
        <address class="ftr__street">
          {site.address.street}<br />
          {site.address.area}, {site.address.city}<br />
          {site.address.state}, {site.address.country}
        </address>
        <p class="mt-4">
          <a href={site.mapsDirectionsUrl} rel="noopener" target="_blank">Open in Google Maps<span class="visually-hidden"> (opens in new tab)</span></a>
        </p>
      </div>

      <nav class="ftr__col" aria-labelledby="ftr-explore">
        <p class="ftr__h" id="ftr-explore">Explore</p>
        <ul>
          <li><a href="/rooms">Rooms</a></li>
          <li><a href="/experience">Experience</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/location">Location</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/reviews">Guest reviews</a></li>
        </ul>
      </nav>

      <nav class="ftr__col" aria-labelledby="ftr-reach">
        <p class="ftr__h" id="ftr-reach">Reach the hotel</p>
        <ul>
          <li><a href="/book">Book your stay</a></li>
          <li><a href="/contact">Contact</a></li>
          {hasPhone() && <li><a href={telHref()}>Call +{site.phone}</a></li>}
          {hasWhatsApp() && <li><a href={whatsappHref()} rel="noopener">WhatsApp</a></li>}
          {hasEmail() && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li><a href={site.mapsUrl} rel="noopener" target="_blank">Google listing<span class="visually-hidden"> (opens in new tab)</span></a></li>
        </ul>
      </nav>
    </div>

    <hr class="rule ftr__rule" />

    <div class="ftr__bottom">
      <p class="small">© {year} {site.legalName}. Sabo, Sagamu, Ogun State.</p>
      <p class="small">
        <a href="/privacy">Privacy</a> · <a href="/gallery#credits">Image credits</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ink);
    color: #dfe4ee;
    padding-block: clamp(3rem, 6vw, 5rem) var(--s-6);
    margin-top: auto;
  }
  .ftr a {
    color: #fff;
  }
  .ftr__top {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 760px) {
    .ftr__top {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  .ftr__name {
    font-family: var(--font-serif);
    font-size: var(--fs-3);
    color: #fff;
  }
  .ftr__street {
    margin-top: var(--s-3);
    font-style: normal;
    font-family: var(--font-serif);
    font-size: var(--fs-2);
    line-height: 1.35;
    color: #fff;
  }
  .ftr__h {
    color: #fff;
    font-weight: 500;
    margin-bottom: var(--s-3);
  }
  .ftr__col ul {
    display: grid;
    gap: var(--s-2);
  }
  .ftr__rule {
    border-color: rgba(255, 255, 255, 0.15);
    margin-block: var(--s-7) var(--s-4);
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    color: #aab3c5;
  }
</style>
