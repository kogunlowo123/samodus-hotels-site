---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import { site } from '@/config/site';
---

<Base title="Privacy" description="How Samodus Hotels handles information entered on this website." noindex stickyBar={false}>
  <PageHead title="Privacy" />
  <section class="section">
    <div class="container measure stack">
      {site.google.ga4MeasurementId ? (
        <p><strong>Analytics:</strong> this site uses Google Analytics 4 to count visits and which buttons are used (call, WhatsApp, directions, booking). IP addresses are anonymised and no names or contact details from the enquiry form are sent to Analytics. Google’s privacy policy applies to that service.</p>
      ) : (
        <p><strong>What this website collects:</strong> nothing on its own. There are no analytics scripts, no advertising trackers and no cookies set by this site.</p>
      )}
      <p><strong>Enquiry forms:</strong> what you type is used to compose a message that you send yourself, by WhatsApp or email, to the hotel. The website does not store or transmit it.</p>
      <p><strong>Map:</strong> the map on the home, Location and Contact pages is embedded from Google Maps. Google’s own privacy policy applies to that embed.</p>
      <p><strong>Reviews:</strong> the rating and reviews shown on the home page and the Reviews page come from Google’s Places service and are fetched by the hotel’s server when the site is built, not by your browser. They are public Google reviews, shown unedited, with reviewer profile pictures loaded from Google.</p>
      <p><strong>Hosting:</strong> the site is served by Render, which keeps standard server access logs (IP address, time, page requested) for security and operations.</p>
      <p><strong>Your rights:</strong> under the Nigeria Data Protection Act 2023 you can ask the hotel what personal information it holds about you from your booking and request correction or deletion. Contact the hotel at {site.address.street}, {site.address.area}, {site.address.city}{site.email ? ` or ${site.email}` : ''}.</p>
      <p class="muted small">Last updated 4 October 2026.</p>
    </div>
  </section>
</Base>
