---
/**
 * Printable A5 card for reception and rooms. Print to PDF from the browser.
 * Not indexed; linked from the review-system documentation only.
 */
import { site, writeReviewUrl } from '@/config/site';
const url = writeReviewUrl();
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reception review card | Samodus Hotels</title>
    <style>
      @page { size: A5; margin: 12mm; }
      :root { color-scheme: light; }
      body { margin: 0; font-family: Georgia, 'Times New Roman', serif; color: #1b2440; background: #fff; }
      .card { max-width: 148mm; margin: 0 auto; padding: 16mm 10mm; text-align: center; }
      h1 { font-size: 22pt; font-weight: 400; margin: 0 0 4mm; }
      p { font-size: 12pt; line-height: 1.4; margin: 0 0 4mm; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      img { width: 60mm; height: 60mm; margin: 6mm auto; display: block; }
      .addr { font-style: italic; color: #5b6472; }
      .rule { width: 24mm; height: 2px; background: #8a5a1e; margin: 6mm auto; border: 0; }
      .note { font-size: 9.5pt; color: #5b6472; }
      .url { font-family: ui-monospace, Consolas, monospace; font-size: 9pt; word-break: break-all; }
      .print { position: fixed; top: 12px; right: 12px; font: 600 14px system-ui, sans-serif; padding: 8px 14px; background: #1b2440; color: #fff; border: 0; border-radius: 6px; cursor: pointer; }
      @media print { .print { display: none; } }
    </style>
  </head>
  <body>
    <button class="print" type="button" onclick="window.print()">Print or save as PDF</button>
    <main class="card">
      <h1>Samodus Hotels</h1>
      <p class="addr">{site.address.street}, {site.address.area}, {site.address.city}</p>
      <hr class="rule" />
      <p>Thank you for staying with us.</p>
      <p>Honest reviews on Google help us improve and help other travellers find us. Good or bad, we read and reply to every one.</p>
      <img src="/qr-review.png" alt="QR code linking to the Google review page for Samodus Hotels" />
      <p class="note">Scan with your phone camera, or visit</p>
      <p class="url">{url}</p>
      <hr class="rule" />
      <p class="note">We never ask for a particular rating and never offer anything in return for a review.</p>
    </main>
  </body>
</html>
