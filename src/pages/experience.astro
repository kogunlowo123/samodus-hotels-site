---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import Figure from '@/components/Figure.astro';
import { amenities } from '@/data/amenities';
import { site } from '@/config/site';

const shown = site.previewMode ? amenities : amenities.filter((a) => a.verified);
---

<Base title="Experience and amenities" description="What to expect at Samodus Hotels, Sabo, Sagamu: air-conditioned rooms, backup power, parking inside the compound and a quiet residential street.">
  <PageHead title="The experience" lead="No spa, no pool, no fuss. A clean room that is cold when you walk in, a safe place for your car, staff who answer, and a quiet night." />

  <section class="section">
    <div class="container split">
      <Figure image="lounge" caption sizes="(min-width: 720px) 42vw, 100vw" />
      <div class="stack">
        <h2>Amenities</h2>
        <ul class="amen">
          {shown.map((a) => (
            <li>
              <h3>
                {a.name}
                {!a.verified && site.previewMode && <span class="badge badge--pending">to confirm</span>}
              </h3>
              <p class="muted">{a.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div class="stack">
        <h2>Food and drink</h2>
        <p>
          Details of meal service, hours and the menu are being confirmed with the hotel and will be published here.
          Until then, ask when you book and the hotel will tell you what is available during your stay.
        </p>
        {site.previewMode && <span class="badge badge--pending">To confirm</span>}
      </div>
      <Figure image="dining" caption sizes="(min-width: 720px) 58vw, 100vw" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Who stays here</h2>
      </div>
      <div class="grid grid-3">
        <div class="stack">
          <h3>Business travellers</h3>
          <p>Visiting Sagamu’s factories and offices for a day or a week. Quiet rooms, a desk, and quick access back to the expressway.</p>
        </div>
        <div class="stack">
          <h3>Families and guests at ceremonies</h3>
          <p>In town for a wedding, naming or burial. Several rooms close together and parking for everyone inside the gate.</p>
        </div>
        <div class="stack">
          <h3>Travellers breaking a journey</h3>
          <p>Between Lagos and Ibadan or heading north. A proper bed instead of driving tired, minutes from the interchange.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container cta">
      <h2 class="display">Ask about your dates.</h2>
      <div class="cluster">
        <a class="btn" href="/book">Book your stay</a>
        <a class="btn btn--on-dark" href="/rooms">See the rooms</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .amen {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 640px) {
    .amen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .amen h3 {
    font-size: var(--fs-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-1);
  }
  .cta {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .cta {
      grid-template-columns: 1fr auto;
    }
  }
</style>
