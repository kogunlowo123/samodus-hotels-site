---
import Base from '@/layouts/Base.astro';
import Figure from '@/components/Figure.astro';
import Gallery from '@/components/Gallery.astro';
import RoomCard from '@/components/RoomCard.astro';
import { rooms, formatNaira, type Room } from '@/data/rooms';
import { site } from '@/config/site';

export function getStaticPaths() {
  return rooms.map((r) => ({ params: { slug: r.slug }, props: { room: r } }));
}

interface Props {
  room: Room;
}
const { room } = Astro.props;
const related = rooms.filter((r) => r.slug !== room.slug).slice(0, 2);
const pending = !room.verified && site.previewMode;

const roomLd = {
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: room.name,
  description: room.summary,
  containedInPlace: { '@id': `${Astro.site}#hotel` },
  ...(room.sleeps ? { occupancy: { '@type': 'QuantitativeValue', maxValue: room.sleeps } } : {}),
  ...(room.beds && room.beds !== 'To be confirmed' ? { bed: { '@type': 'BedDetails', typeOfBed: room.beds } } : {}),
};
---

<Base title={room.name} description={`${room.name} at Samodus Hotels, Sabo, Sagamu. ${room.summary}`} jsonLd={roomLd}>
  <section class="section rd">
    <div class="container">
      <p class="small"><a href="/rooms">All rooms</a></p>
      <div class="rd__head">
        <h1 class="mt-2">{room.name}</h1>
        {pending && <span class="badge badge--pending">Details awaiting confirmation</span>}
      </div>
      <p class="lead mt-4">{room.summary}</p>

      <div class="rd__gallery mt-6">
        <Figure image={room.images[0]} priority sizes="(min-width: 1024px) 66vw, 100vw" ratio="3 / 2" />
        <div class="rd__side">
          {room.images.slice(1, 3).map((id) => (
            <Figure image={id} sizes="(min-width: 1024px) 33vw, 50vw" ratio="4 / 3" />
          ))}
        </div>
      </div>

      <div class="split mt-8">
        <aside class="rd__book">
          <div class="card">
            <div class="card__body">
              <p class="serif" style="font-size: var(--fs-3)">
                {room.price !== null ? (
                  <>{formatNaira(room.price)} <span class="muted small">per night</span></>
                ) : (
                  'Rate on request'
                )}
              </p>
              <p class="muted small">Availability and rate are confirmed directly by the hotel. No payment on this site.</p>
              <a class="btn btn--block" href={`/book?room=${room.slug}`}>Enquire about this room</a>
              <a class="btn btn--ghost btn--block" href="/contact">Ask a question</a>
            </div>
          </div>
        </aside>

        <div class="stack-lg">
          <div class="stack">
            <h2>Overview</h2>
            <p>{room.description}</p>
          </div>

          <dl class="dl">
            <dt>Bed</dt>
            <dd>{room.beds}</dd>
            <dt>Sleeps</dt>
            <dd>{room.sleeps ?? 'To be confirmed'}</dd>
            {room.size && (
              <>
                <dt>Size</dt>
                <dd>{room.size}</dd>
              </>
            )}
            <dt>Bathroom</dt>
            <dd>{room.bathroom}</dd>
          </dl>

          <div class="stack">
            <h2>In the room</h2>
            <ul class="checks">
              {room.amenities.map((a) => <li>{a}</li>)}
            </ul>
          </div>

          <div class="stack">
            <h2>Policies</h2>
            {room.policies.length ? (
              <ul class="checks">
                {room.policies.map((p) => <li>{p}</li>)}
              </ul>
            ) : (
              <p class="muted">
                Check-in and check-out times, cancellation terms and house rules will be listed here once the hotel
                confirms them. Ask when you enquire and the hotel will tell you directly.
              </p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2>More photographs</h2>
      <div class="mt-6">
        <Gallery ids={room.images} filters={false} />
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Other rooms</h2>
        <div class="grid grid-2 mt-6">
          {related.map((r) => <RoomCard room={r} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .rd__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
  }
  .rd__gallery {
    display: grid;
    gap: var(--s-3);
  }
  .rd__side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
  }
  @media (min-width: 900px) {
    .rd__gallery {
      grid-template-columns: 2fr 1fr;
    }
    .rd__side {
      grid-template-columns: 1fr;
    }
  }
  .rd__book {
    order: 2;
  }
  @media (min-width: 720px) {
    .rd__book {
      order: 0;
      position: sticky;
      top: 88px;
    }
  }
</style>
